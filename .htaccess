# Clean URLs and transport security for a flat static site.
#
# Files on disk keep their .html names; this file is what makes
# /about serve about.html, and what sends the old .html URLs to
# their new home with a permanent redirect so search rankings and
# any existing inbound links follow. It also forces HTTPS, folds
# www onto the bare domain, and sets the response headers browsers
# use to decide how much to trust the page.
#
# Hostinger runs LiteSpeed, which reads .htaccess the way Apache does.
# If the server already has an .htaccess (SSL or www redirects added
# from hPanel), merge these rules into it rather than replacing it --
# the HTTPS and www blocks below are the ones hPanel writes, so if you
# find near-identical rules there, keep one copy, not both.

<IfModule mod_negotiation.c>
  # Let the rules below decide what /about means, not content negotiation.
  Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On

# ---------------------------------------------------------------------------
# Retired domain: talkingtailstn.com -> talkingtailsdogtraining.com
#
# talkingtailstn.com is an alias domain on this hosting account, pointed here
# by an A record that still lives in GoDaddy's DNS (so its MX and TXT records,
# and the mail they carry, stay where they are). Being an alias means it serves
# this same public_html, which without these rules would put the entire site at
# a second address -- two hostnames, identical pages, and only the canonical
# tags to tell Google which one counts. These rules send it away instead.
#
# First in the file on purpose. Every rule below rewrites within the current
# host, so anything reached before this point would redirect twice: once to
# fix the scheme or strip the www, then again to change domain. Jumping
# straight to the new domain's https URL is one hop from wherever a visitor
# started.
#
# Renamed paths first, then the catch-all, because the first match wins.
#
# These are the old site's seven pages. /videos, /reviews and /quiz kept their
# names and need no rule -- the catch-all below lands them on the pages of the
# same name here. The four that changed are listed individually, since passing
# them through untouched would only trade a dead old URL for a dead new one.
#
#   /training-programs -> /training
#   /about-us          -> /about
#   /contact-us        -> /contact
#   /career            -> /contact   (see below)
#
# Each carries its own host condition rather than sharing one. A RewriteCond
# binds only to the rule directly after it, so there is no way to hoist it;
# spelling it out per rule also means a line pair can be copied, edited and
# pasted for the next renamed path without the host test being left behind.
#
# The (/.*)?$ tail matches the path bare, with a trailing slash, and with
# anything nested beneath it, so /training-programs, /training-programs/ and
# /training-programs/puppy all land in one hop.
RewriteCond %{HTTP_HOST} ^(www\.)?talkingtailstn\.com$ [NC]
RewriteRule ^training-programs(/.*)?$ https://talkingtailsdogtraining.com/training [R=301,L]

RewriteCond %{HTTP_HOST} ^(www\.)?talkingtailstn\.com$ [NC]
RewriteRule ^about-us(/.*)?$ https://talkingtailsdogtraining.com/about [R=301,L]

RewriteCond %{HTTP_HOST} ^(www\.)?talkingtailstn\.com$ [NC]
RewriteRule ^contact-us(/.*)?$ https://talkingtailsdogtraining.com/contact [R=301,L]

# /career has no successor -- this site has no careers page. /contact is the
# nearest honest destination, since it carries the phone number and email an
# applicant would need, and it beats dropping them on a 404. It is a
# placeholder for a decision, not a mapping: point this at a real careers
# page once one exists, or at /trainers if the intent is to show the team.
# Matches /careers too, in case the old path was ever spelled that way.
RewriteCond %{HTTP_HOST} ^(www\.)?talkingtailstn\.com$ [NC]
RewriteRule ^careers?(/.*)?$ https://talkingtailsdogtraining.com/contact [R=301,L]

# Trailing slashes, folded in while the domain changes rather than after it.
# The old site wrote its URLs with them (/videos/), and this site's canonical
# form has none. Without this the catch-all would hand /videos/ to the new
# domain intact, where the rule further down would bounce it again to /videos
# -- two redirects where one will do, on the majority of old inbound links.
RewriteCond %{HTTP_HOST} ^(www\.)?talkingtailstn\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.+?)/+$ https://talkingtailsdogtraining.com/$1 [R=301,L]

# Everything else: same path, new domain, query string carried along by the
# server. Unlisted paths are deliberately sent to the matching path here and
# allowed to 404 if there is none -- a wrong page is worse than an honest
# miss, and the 404s surface in Search Console where they can be mapped.
#
# .well-known is the exception, because Let's Encrypt validates this domain's
# certificate by fetching /.well-known/acme-challenge/ over plain HTTP --
# redirect that away and issuance fails now and renewal fails every 90 days
# after, each time taking HTTPS on the old domain down with it.
RewriteCond %{HTTP_HOST} ^(www\.)?talkingtailstn\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://talkingtailsdogtraining.com%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# Transport: HTTPS and the canonical hostname.
# These run before the clean-URL rules so a request only ever changes
# scheme/host once, then changes path once.
# ---------------------------------------------------------------------------

# Plain HTTP  ->  HTTPS, same host and path.
#
# Both conditions must fail for the redirect to fire. %{HTTPS} covers a
# server that terminates TLS itself; X-Forwarded-Proto covers one sitting
# behind a proxy or CDN that terminates it upstream (Cloudflare's "Flexible"
# mode, for one). Testing only %{HTTPS} in that second case would loop
# forever, because the origin never sees an HTTPS request to satisfy it.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# www  ->  bare domain, matching the canonical URL every page declares.
#
# This only helps visitors who reach https://www... successfully, which
# means the TLS certificate has to list the www name too -- the handshake
# happens before any of these rules run, so a certificate that covers only
# the bare domain gives Safari a full-page warning that no redirect can
# undo. Confirm both names are on the certificate in hPanel.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# Files that ship with the source but should not be served.
# ---------------------------------------------------------------------------

# Dot-directories and dotfiles, so an uploaded .git folder can't be walked
# to reconstruct the repository. .well-known is exempt: Let's Encrypt reads
# /.well-known/acme-challenge/ to renew the certificate, and blocking it
# would break renewal and eventually take HTTPS down with it.
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]

# The deployment notes, which describe the hosting setup.
RewriteRule ^README\.md$ - [F,L]

# ---------------------------------------------------------------------------
# Clean URLs.
# ---------------------------------------------------------------------------

# /index.html and /index  ->  /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /about.html  ->  /about   (one permanent redirect, not a loop:
# the internal rewrite at the bottom doesn't re-enter THE_REQUEST)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# /about/  ->  /about  so relative URLs never resolve a level too deep
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /about  ->  about.html, served in place with no visible redirect
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

# ---------------------------------------------------------------------------
# Security headers.
# ---------------------------------------------------------------------------

<IfModule mod_headers.c>

  # Tell browsers to reach this site over HTTPS for the next year without
  # trying HTTP first, closing the window where that opening request can be
  # downgraded before the redirect above ever runs.
  #
  # Sent unconditionally on purpose: RFC 6797 requires browsers to ignore
  # this header when it arrives over plain HTTP, so there is no need to
  # guard it, and no way for it to take effect prematurely.
  #
  # Deliberately without includeSubDomains. Adding it would force HTTPS on
  # *every* subdomain, webmail and cpanel included, and browsers honour it
  # for the full max-age even if you remove the header the next day. Add it
  # only after confirming every subdomain serves HTTPS correctly:
  #   Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Trust the declared Content-Type instead of sniffing the bytes, so an
  # uploaded file can't be talked into executing as script.
  Header always set X-Content-Type-Options "nosniff"

  # No other origin may frame these pages. Blocks the clickjacking trick of
  # floating an invisible copy of the site over bait content.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Send the full URL as a referrer only to this site; cross-origin requests
  # get the bare origin, and HTTPS -> HTTP gets nothing.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Nothing on the site asks for these, so decline them up front -- for the
  # embedded forms as well, since a frame can't be granted more than its
  # parent holds. If a hosted form ever needs a camera upload or address
  # autofill, drop the matching entry.
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=()"

  # A Content-Security-Policy for this site, left off by default.
  #
  # Enabling it is worth doing, but it is not a set-and-forget line: every
  # new Google Tag Manager tag that loads a script from a new host will be
  # blocked until that host is added to script-src, and the failure shows up
  # only in the browser console. Turn it on, then walk every page with the
  # console open -- home, contact, quiz, thanks, reviews -- and confirm the
  # embedded forms still render and submit and the review widget still fills
  # in. The widget is the most fragile of the three: it pulls script, CSS,
  # fonts, review JSON and reviewer avatars, so it trips five directives
  # rather than one.
  #
  # 'unsafe-inline' in script-src is unavoidable here: the gtag and GTM
  # snippets are inline <script> blocks in every page's <head>. It weakens
  # the policy considerably, though the rest still holds -- object-src,
  # base-uri and form-action all shut down injection routes that inline
  # script alone can't reach.
  #
  # cdn.trustindex.io is the review widget on /reviews, and googleusercontent
  # is where the reviewer profile photos inside it are served from.
  #
  # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://links.talkingtailsdogtraining.com https://cdn.trustindex.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.trustindex.io; font-src 'self' https://fonts.gstatic.com https://cdn.trustindex.io; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com https://cdn.trustindex.io https://*.googleusercontent.com; connect-src 'self' https://www.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com https://links.talkingtailsdogtraining.com https://cdn.trustindex.io; frame-src https://links.talkingtailsdogtraining.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

</IfModule>
